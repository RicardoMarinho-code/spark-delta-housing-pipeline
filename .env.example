# Copy to .env (never committed). Values for development with synthetic data only.

# HMAC pseudonymization key (at least 32 characters). In production it comes from Key Vault.
PSEUDONYMIZATION_KEY=replace-with-a-random-key-of-at-least-32-characters

# Optional
# MONGO_URI=mongodb://localhost:27017
# ALERT_WEBHOOK_URL=https://example.webhook.office.com/...
# HOUSING_INPUT=data/input
# HOUSING_LAKEHOUSE=data/lakehouse
# MLFLOW_TRACKING_URI=file:./mlruns
